{
  "name": "hermes-teammates",
  "version": "0.1.0",
  "description": "An open source, Grok Bot inspired workspace for persistent Hermes agents.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx server/index.ts --dev",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/index.js",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts && node --test electron/native-controls.test.cjs",
    "desktop": "npm run build && node electron/build-native.cjs && node scripts/desktop.mjs",
    "package:desktop": "npm run build && electron-builder --dir",
    "verify:ui": "npm run build && node electron/build-native.cjs && tsx scripts/verify-ui.ts",
    "format": "prettier --write src mobile/src mobile/*.ts mobile/*.html server scripts test electron .github *.json *.ts *.html *.md docs/*.md",
    "format:check": "prettier --check src mobile/src mobile/*.ts mobile/*.html server scripts test electron .github *.json *.ts *.html *.md docs/*.md",
    "verify:computer": "npm run build && tsx scripts/verify-computer.ts",
    "verify:connections": "npm run build && tsx scripts/verify-connections.ts",
    "verify:vault": "npm run build && tsx scripts/verify-vault.ts",
    "build:mobile": "tsc --noEmit && vite build --config mobile/vite.config.ts",
    "mobile:sync": "npm run build:mobile && cap sync",
    "mobile:ios": "npm run mobile:sync && cap open ios",
    "mobile:android": "npm run mobile:sync && cap open android",
    "verify:mobile": "npm run build && npm run build:mobile && tsx scripts/verify-mobile.ts",
    "mobile:fixture": "tsx scripts/mobile-fixture.ts"
  },
  "main": "electron/main.cjs",
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "@novnc/novnc": "^1.7.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "ws": "^8.22.0",
    "yaml": "^2.8.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.3",
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/novnc__novnc": "^1.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "build": {
    "appId": "org.hermesteammates.desktop",
    "productName": "Hermes Teammates",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/hermes_bridge.py",
      "server/action_review.py",
      "package.json",
      "LICENSE",
      "server/computer/**/*",
      "server/computer_mcp.py",
      "THIRD_PARTY_NOTICES.md",
      "licenses/**/*"
    ],
    "asarUnpack": [
      "server/hermes_bridge.py",
      "server/action_review.py",
      "server/computer/**/*",
      "server/computer_mcp.py"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "extraResources": [
        {
          "from": "test-artifacts/native-macos/${arch}/HermesNativeControls.node",
          "to": "native/HermesNativeControls.node"
        }
      ]
    },
    "linux": {
      "target": "AppImage"
    },
    "win": {
      "target": "nsis"
    },
    "beforePack": "electron/before-pack.cjs"
  },
  "author": "Hermes Teammates contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dafzthomas/hermes-teammates.git"
  },
  "homepage": "https://github.com/dafzthomas/hermes-teammates#readme",
  "bugs": {
    "url": "https://github.com/dafzthomas/hermes-teammates/issues"
  }
}
